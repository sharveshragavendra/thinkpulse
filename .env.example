# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional origin allowlist for strict CORS checks (comma-separated)
APP_ORIGIN=""

# Server-only cryptographic signing secrets (configure in production Secrets panel)
SESSION_SIGNING_SECRET=""
QR_TOKEN_PEPPER=""

# Optional logging verbosity (info | warn | error)
LOG_LEVEL="info"

# Optional mail provider for transactional password recovery
MAIL_PROVIDER=""
MAIL_API_KEY=""
MAIL_FROM=""

# Optional external Supabase PostgreSQL connection (use either SUPABASE_DB_* or DATABASE_URL)
DATABASE_URL=""
SUPABASE_DB_HOST=""
SUPABASE_DB_PORT="6543"
SUPABASE_DB_USER=""
SUPABASE_DB_PASSWORD=""
SUPABASE_DB_NAME="postgres"

# Optional Firebase project ID override (defaults to firebase-applet-config.json)
FIREBASE_PROJECT_ID=""
